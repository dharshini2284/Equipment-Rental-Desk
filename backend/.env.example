# Copy to .env for local runs. Every value has a working default, so .env is optional.

# SQLAlchemy URL. SQLite file for local work; PostgreSQL in Docker Compose and production.
# postgres:// and postgresql:// URLs are accepted and given the psycopg driver automatically.
DATABASE_URL=sqlite:///./rental_desk.db

# Comma-separated browser origins allowed to call the API (the UI's URL).
CORS_ORIGINS=http://localhost:5173

# Accept the X-Test-Clock header so reviewers can move "now". Set to false to disable.
ALLOW_TEST_CLOCK=true

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
