# Base URL of the API, without a trailing slash. Leave empty in development: Vite proxies
# /api to DEV_API_PROXY_TARGET. Set it for production builds, e.g.
# VITE_API_BASE_URL=https://rental-desk-api.onrender.com
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests (development only).
DEV_API_PROXY_TARGET=http://localhost:8000
